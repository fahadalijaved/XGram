<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- XGram M3E: the system splash with Expressive design (set for the next launch by MainActivity): the surface of the
       light or dark scheme, or black with Pure black, and the app icon (the chosen launcher icon) on primaryContainer.
       The app theme itself is untouched, so with Expressive design off the splash stays the system's default. -->
  <style name="XgramR5SecuritySplashLight" parent="@style/AppTheme">
    <item name="android:windowSplashScreenBackground">@android:color/system_neutral1_10</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@android:color/system_accent1_100</item>
  </style>

  <style name="XgramR5SecuritySplashDark" parent="@style/AppTheme.Dark">
    <item name="android:windowSplashScreenBackground">@android:color/system_neutral1_900</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@android:color/system_accent1_700</item>
  </style>

  <style name="XgramR5SecuritySplashBlack" parent="@style/AppTheme.Dark">
    <item name="android:windowSplashScreenBackground">@android:color/black</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@android:color/system_accent1_700</item>
  </style>
</resources>
