<?xml version="1.0" encoding="utf-8"?>
<!-- XGram M3E round 6 (b3): the Material alert dialogs (see values-v21) with the dynamic primary as the accent: tone 40
     (light) and 80 (dark) of the device's primary palette, as XgramExpressive.systemRole builds PRIMARY. -->
<resources>
  <style name="XgramDialogM3" parent="@android:style/Theme.Material.Light.Dialog.Alert">
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:colorAccent">@android:color/system_accent1_600</item>
    <item name="android:textColorLink">@android:color/system_accent1_600</item>
    <item name="android:backgroundDimAmount">0.32</item>
    <item name="android:windowElevation">6dp</item>
  </style>
  <style name="XgramDialogM3Dark" parent="@android:style/Theme.Material.Dialog.Alert">
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:colorAccent">@android:color/system_accent1_200</item>
    <item name="android:textColorLink">@android:color/system_accent1_200</item>
    <item name="android:backgroundDimAmount">0.32</item>
    <item name="android:windowElevation">6dp</item>
  </style>
</resources>
