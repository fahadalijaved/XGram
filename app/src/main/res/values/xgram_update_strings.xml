  <!-- XGram update screen ("Software update", com.fahadali.xgram.update.XgramUpdateScreen): the update prompt, What's new and the install, in one card -->

  <!-- Ids -->
  <item name="btn_xgramUpdatePreview" type="id" />

  <!-- Title and version -->
  <string name="XgramUpdTitle">Software update</string>
  <string name="XgramUpdAvailable">XGram %1$s is available.</string>
  <string name="XgramUpdReady">XGram %1$s is ready to install.</string>
  <string name="XgramUpdSizeKind">%1$s · %2$s</string>

  <!-- What's new -->
  <string name="XgramUpdWhatsNew">What’s new</string>
