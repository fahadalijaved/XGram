  <!-- Preview (Settings, tap the version, Application Logs, Testing Utilities) -->
  <string name="XgramUpdPreview">Preview update screen</string>
  <string name="XgramUpdPreviewTag">Preview</string>
  <string name="XgramUpdLooking">Looking for the newest post…</string>
  <string name="XgramUpdPreviewDone">Preview: nothing was installed</string>
  <string name="XgramUpdPreviewSample">✨ New\n• Software update (Settings → XGram → Updates): the notes, the download and the install in one card\n• Popup menu (Message menu → Popup menu, off by default): a long press opens a menu right next to the message\n• A bot’s profile → Add to group or channel: add it to several chats at once, as admin\n• Camera X (Testing Utilities, off by default): lens buttons, Night, Portrait and HDR\n\n🛠️ Improved\n• Chats slide open more smoothly\n\n🐞 Fixed\n• Settings pages could crash while scrolling fast\n\nBased on Telegram X 0.29.1.1818. A sample: no post was found.</string>
