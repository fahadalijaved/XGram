<resources>
  <!-- XGram update screen ("Software update", com.fahadali.xgram.update.XgramUpdateScreen): the update prompt, What's new and the install, in one card -->

  <!-- Ids -->
  <item name="btn_xgramUpdatePreview" type="id" />
  <item name="btn_xgramWelcomePreview" type="id" />

  <!-- Title and version -->
  <string name="XgramUpdTitle">Software update</string>
  <string name="XgramUpdAvailable">XGram %1$s is available.</string>
  <string name="XgramUpdReady">XGram %1$s is ready to install.</string>
  <string name="XgramUpdSizeKind">%1$s · %2$s</string>

  <!-- What's new -->
  <string name="XgramUpdWhatsNew">What’s new</string>
  <string name="XgramUpdSeeAll">See all changes (%1$s)</string>
  <string name="XgramUpdSource">Source code</string>
  <string name="XgramUpdDonate">Donate</string>
  <string name="XgramUpdSeeLess">Show less</string>
  <!-- A section's count badge, for TalkBack ("New, 6 changes") -->
  <string name="XgramUpdChangesOne">%1$s change</string>
  <string name="XgramUpdChangesMany">%1$s changes</string>

  <!-- Actions -->
  <string name="XgramUpdInstallNow">Install now</string>
  <string name="XgramUpdLater">Later</string>
  <string name="XgramUpdDownloadAgain">Download again</string>
  <string name="XgramUpdDownloading">Downloading…</string>
  <string name="XgramUpdStarting">Starting the download…</string>
  <string name="XgramUpdDownloadedOf">%1$s of %2$s</string>
  <string name="XgramUpdPercent">%1$d%%</string>
  <string name="XgramUpdPercentDownloaded">%1$d%% downloaded</string>
  <string name="XgramUpdBackground">Continue in background</string>
  <string name="XgramUpdCancel">Cancel</string>
  <string name="XgramUpdChecking">Checking the file…</string>
  <string name="XgramUpdCheckingInfo">It installs only if its SHA-256 matches the post.</string>

  <!-- Errors -->
  <string name="XgramUpdBadFile">The file didn’t match its SHA-256 and was deleted.</string>
  <string name="XgramUpdStopped">The download stopped. Try again.</string>
  <string name="XgramUpdCanceled">Download canceled.</string>
  <string name="XgramUpdNotStarted">The download didn’t start. Check your connection and try again.</string>

  <!-- Welcome after an update ("What's new in XGram <version>"): the same card, once per version, with the highlights
       (com.fahadali.xgram.update.XgramWelcome) -->
  <string name="XgramWelcomeTitle">Welcome to XGram %1$s</string>
  <!-- The four highlights built into the app (XgramWelcome.BUILT_IN) -->
  <string name="XgramWelcomeIntro">Four big new features, made for XGram. Try one now.</string>
  <!-- A later version's welcome: the highlights and notes of its post -->
  <string name="XgramWelcomeIntroNotes">Here’s what’s new in this version.</string>
  <string name="XgramWelcomeTryIt">Try it</string>
  <string name="XgramWelcomeGotIt">Got it</string>
  <!-- One line per highlight (the names are the features' own: Activity, Undo send, Check In, Later) -->
  <string name="XgramWelcomeActivityInfo">Every mention of you and every reply and reaction to your messages, from all your chats, in one place.</string>
  <string name="XgramWelcomeUndoSendInfo">A message waits a few seconds after Send, so you can take it back before anyone gets it. Pick a delay to turn it on.</string>
  <string name="XgramWelcomeCheckInInfo">From a chat’s ⋮ menu, say when you’ll be back. If you don’t tap I’m safe in time, Telegram sends them an alert, even if your phone is off.</string>
  <string name="XgramWelcomeLaterInfo">Snooze a chat until a time or until they reply, and get reminded about any message.</string>

  <!-- Preview (Settings, tap the version, Application Logs, Testing Utilities) -->
  <string name="XgramUpdPreview">Preview update screen</string>
  <string name="XgramWelcomePreview">Preview welcome screen</string>
  <string name="XgramUpdPreviewTag">Preview</string>
  <string name="XgramUpdLooking">Looking for the newest post…</string>
  <string name="XgramUpdPreviewDone">Preview: nothing was installed</string>
  <string name="XgramUpdPreviewSample">🌟 Highlights\n• Activity: every mention of you and every reply and reaction to your messages, in one place\n• Undo send: a message waits a few seconds after Send, so you can take it back\n• Check In (a chat’s ⋮ menu): if you don’t tap I’m safe in time, Telegram sends them an alert\n• Later: snooze a chat until a time or until they reply\n\n✨ New\n• Software update (Settings → XGram → Updates): the notes, the download and the install in one card\n• Popup menu (Message menu → Popup menu, off by default): a long press opens a menu right next to the message\n• A bot’s profile → Add to group or channel: add it to several chats at once, as admin\n• Camera X (Testing Utilities, off by default): lens buttons, Night, Portrait and HDR\n\n🛠️ Improved\n• Chats slide open more smoothly\n\n🐞 Fixed\n• Settings pages could crash while scrolling fast\n\nBased on Telegram X 0.29.1.1818. A sample: no post was found.</string>
