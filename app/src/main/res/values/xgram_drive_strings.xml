  <!-- The drive -->
  <string name="XgramDriveTest">XGram Drive (test)</string>
  <string name="XgramDriveTestInfo">In the side menu and in the message menu (Save to XGram Drive). Still a test: CI builds have it off until it is switched on here.</string>
  <string name="XgramDrive">XGram Drive</string>
  <string name="XgramDriveChannelAbout">Files kept in XGram Drive. Manage them in XGram: side menu → XGram Drive. Please don\'t post here by hand.</string>
  <string name="XgramDriveIntroText">Keep your files in Telegram\'s cloud, in a private channel only you can see. Make folders, upload files, photos and videos, save files from any chat, and open them on every device you sign in to.</string>
  <string name="XgramDriveIntroNote">XGram makes a private channel named “XGram Drive” for this, archived and muted. Each file can be up to %1$s.</string>
