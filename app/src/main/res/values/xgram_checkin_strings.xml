  <!-- Before starting -->
  <string name="XgramCheckInConflict">You already have a Check In with %1$s. End it before starting a new one.</string>
  <string name="XgramCheckInOpenChat">Open chat</string>
  <string name="XgramCheckInCantStart">Can\'t start Check In</string>
  <string name="XgramCheckInPaid">Messages to %1$s cost Stars, so Check In can\'t schedule an alert.</string>
  <string name="XgramCheckInRestricted">%1$s only accepts messages from contacts or Premium users.</string>
  <string name="XgramCheckInDeletedAccount">This account was deleted.</string>
  <string name="XgramCheckInExplainer">Let %1$s know you got where you were going. If you don\'t end Check In in time, Telegram sends them a message you schedule now, with your last known location and battery level, even if your phone is off or lost.\n\nYour location is kept in that scheduled message on Telegram\'s servers and refreshed about every 5 minutes; %1$s only sees it if the alert is sent. Your other devices show it under Scheduled messages. Whether %1$s hears it depends on their notification settings.\n\nCheck In is best effort and isn\'t an emergency service. If you\'re in danger, call your local emergency number.</string>
  <string name="XgramCheckInNotNow">Not now</string>

