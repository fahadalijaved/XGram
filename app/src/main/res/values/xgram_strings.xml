  <string name="XgramWhatsNew">What’s new in XGram</string>
  <string name="XgramWhatsNewInfo">Everything XGram adds to Telegram&#160;X</string>
  <string name="XgramWhatsNewIntro">XGram brings the best of AyuGram, NagramX and exteraGram to Telegram&#160;X. Tap a row to try it.</string>
  <string name="XgramWhatsNewOutro">Find this list again in the side menu → XGram.</string>
  <string name="XgramNewGhost">Ghost mode</string>
  <string name="XgramNewGhostInfo">Read without read receipts, stay offline, no typing, send as scheduled or silently. Counters still clear on your phone.</string>
  <string name="XgramNewTopics">Topic groups, done right</string>
  <string name="XgramNewTopicsInfo">Topic list or tabs (top or side), search, pinned order, typing in rows, per-topic pins and mute, correct unread badges.</string>
  <string name="XgramNewHistory">Deleted and edited messages</string>
  <string name="XgramNewHistoryInfo">Deleted messages stay in the chat with a trash icon, media included. See every version of edited messages.</string>
  <string name="XgramNewIcons">New app icons</string>
  <string name="XgramNewIconsInfo">Ten XGram icons, from Midnight neon to Gold, with themed icons on Android 13+.</string>
  <string name="XgramNewBookmarks">Bookmarks</string>
  <string name="XgramNewBookmarksInfo">Bookmark any message and find it again in one list.</string>
  <string name="XgramNewSavedByChat">Saved Messages by chat</string>
  <string name="XgramNewSavedByChatInfo">Your Saved Messages grouped by the chat they came from.</string>
  <string name="XgramNewMessageTools">Message tools</string>
  <string name="XgramNewMessageToolsInfo">Long-press a message: Repeat, Save to Saved Messages, Copy photo, Reply privately, Transcribe, Details with read time, View in topic.</string>
  <string name="XgramNewFilters">Filters and shadow bans</string>
  <string name="XgramNewFiltersInfo">Hide messages by words or from people, including blocked users in groups.</string>
  <string name="XgramNewLook">Look and feel</string>
  <string name="XgramNewLookInfo">Material You colors, avatar corners, system font, side menu items.</string>
  <string name="XgramNewTwoPane">Foldables and tablets</string>
  <string name="XgramNewTwoPaneInfo">Chat list and chat side by side when the screen is wide enough.</string>
  <string name="XgramNewProfiles">Profiles</string>
  <string name="XgramNewProfilesInfo">IDs with estimated registration date, join date in groups, local names only you see.</string>
  <string name="XgramNewPrivacy">Privacy and cleanup</string>
