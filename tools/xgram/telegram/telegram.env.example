# XGram Build Bot config: TEMPLATE ONLY, with placeholders.
# Copy it OUTSIDE the repo and fill it in there:
#   mkdir -p ~/.xgram && cp tools/xgram/telegram/telegram.env.example ~/.xgram/telegram.env
# Environment variables with the same names override this file (that is what CI uses).
# A value that still starts with "<" counts as "not set". Never commit the real file.

# Secret. From @BotFather (the message you got when you created the bot, or /token).
XGRAM_BOT_TOKEN=<BOT_TOKEN>

# The "XGram" forum group and the "XGram CI" channel. Bot API ids look like -100XXXXXXXXXX.
# You can also paste a link: https://t.me/c/<N>/... (private) or @username (public).
# 'xgram_bot.py discover --send' prints them.
XGRAM_GROUP_ID=<GROUP_ID>
XGRAM_CHANNEL_ID=<CHANNEL_ID>

# Topic ids (General needs none). A topic link copied in XGram works too: https://t.me/c/<N>/<topic>
XGRAM_TOPIC_UPDATES=<TOPIC_UPDATES>
XGRAM_TOPIC_SUPPORT=<TOPIC_SUPPORT>
# Any other topic becomes a target too, e.g. 'post --to releases':
# XGRAM_TOPIC_RELEASES=<TOPIC_RELEASES>

# Only for a PRIVATE CI channel: its invite link, for {{CI_CHANNEL_LINK}} in the posts. For a public channel, set
# XGRAM_CHANNEL_ID=@<username> instead and the link is worked out. Keep it here, never in the post files.
# XGRAM_CI_CHANNEL_LINK=https://t.me/+<INVITE>

# Optional: only for files over the Bot API upload limit (the debug APK is ~73 MB).
# Get them at https://my.telegram.org -> API development tools. TELEGRAM_API_HASH is a secret.
# TELEGRAM_API_ID=<API_ID>
# TELEGRAM_API_HASH=<API_HASH>

# Optional: a self-hosted telegram-bot-api server started with --local (uploads up to 2000 MB).
# When set, it is used for every call instead of api.telegram.org. See README.md first (logOut).
# XGRAM_BOT_API_URL=http://127.0.0.1:8081

# Optional: a link to the source of the published build (GPLv3), added to each APK caption.
# XGRAM_SOURCE_URL=<SOURCE_URL>

# Optional: the size above which uploads go through Telethon instead of the cloud Bot API
# (MB of 1,000,000 bytes, default 49: below the "50 MB" limit in either unit).
# XGRAM_CLOUD_UPLOAD_MB=49
